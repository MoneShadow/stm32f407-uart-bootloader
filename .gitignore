*.o
*.obj
*.a
*.elf
*.axf
*.map
*.bin
*.hex
*.srec
*.lst
*.d
*.su
*.gcda
*.gcno
*.gcov

# GDB / OpenOCD runtime state
.gdb_history
*.gdbinit.local
*.svd.patched

# Editor-local files (shared .vscode project files remain tracked)
.history/
*.code-workspace
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db

# Python cache for host-side tools
__pycache__/
*.py[cod]
.venv/
venv/

