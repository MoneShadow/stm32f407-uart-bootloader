/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/build.ninja
/.ninja_deps
/.ninja_log
/compile_commands.json
/install_manifest.txt

# Per-user CMake configuration
/CMakeUserPresets.json

